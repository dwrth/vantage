{
  "name": "vantage",
  "version": "0.2.2",
  "description": "Controlled grid layout builder for React",
  "type": "module",
  "main": "./dist/vantage.cjs.js",
  "module": "./dist/vantage.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/vantage.es.js",
      "require": "./dist/vantage.cjs.js"
    },
    "./style.css": "./dist/vantage.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build": "vite build",
    "prepare": "npm run build",
    "build:example": "vite build --config example/vite.config.ts",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --config example/vite.config.ts"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "react",
    "grid",
    "layout",
    "builder",
    "drag-and-drop"
  ],
  "license": "MIT"
}
